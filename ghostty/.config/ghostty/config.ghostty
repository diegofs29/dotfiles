# ==============================================================================
# APARIENCIA Y TEMA
# ==============================================================================

# Tema minimalista oscuro (puedes cambiarlo con `ghostty +list-themes`)
theme = Catppuccin Mocha

# Fuente (EndeavourOS suele incluir JetBrains Mono por defecto)
font-family = "JetBrains Mono"
font-size = 12

# Margen interno para que el texto no pegue en los bordes
window-padding-x = 8
window-padding-y = 8

# Tamaño inicial de la ventana (columnas x filas)
window-height = 28
window-width = 90

# Transparencia ligera
background-opacity = 0.95

# ==============================================================================
# CURSOR Y COMPORTAMIENTO
# ==============================================================================

cursor-style = block
cursor-style-blink = true

# Desactivar la campana sonora del sistema
desktop-notifications = false

# ==============================================================================
# ATAJOS DE TECLADO (LINUX / ENDEAVOUROS)
# ==============================================================================

# Copiar y pegar estándar en terminales Linux
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard

# Pestañas
keybind = ctrl+shift+t=new_tab
keybind = ctrl+shift+w=close_surface
keybind = ctrl+tab=next_tab
keybind = ctrl+shift+tab=previous_tab

# Paneado / División de pantalla (Splits)
keybind = alt+shift+d=new_split:right
keybind = alt+shift+s=new_split:down

# Navegación entre paneles divididos
keybind = alt+left=goto_split:left
keybind = alt+right=goto_split:right
keybind = alt+up=goto_split:top
keybind = alt+down=goto_split:bottom

# Recargar configuración
keybind = ctrl+shift+r=reload_config